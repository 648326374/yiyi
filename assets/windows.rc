#include "resource.h"

IDI_YIYI ICON "app.ico"
1 VERSIONINFO
FILEVERSION YIYI_VERSION_TUPLE
PRODUCTVERSION YIYI_VERSION_TUPLE
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Yiyi"
      VALUE "FileDescription", "Yiyi AI Dictionary"
      VALUE "FileVersion", YIYI_VERSION_STRING
      VALUE "InternalName", "Yiyi"
      VALUE "ProductName", "Yiyi"
      VALUE "ProductVersion", YIYI_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
